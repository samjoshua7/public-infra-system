# Express AI service environment variables
# Copy this file to "server/.env" and fill in the real values.
# Never commit the real ".env" file.

PORT=5000

# Get this free from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for photo auto-fill
GEMINI_MODEL=gemini-2.5-flash-lite

# Frontend origin allowed to call this server (CORS)
FRONTEND_URL=http://localhost:5173
