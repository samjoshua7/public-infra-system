# Express AI service environment variables
# Copy this file to "server/.env" and fill in your real OPENROUTER_API_KEY.
# Never commit the real ".env" file.

PORT=5000

# Get a free key from OpenRouter (no credit card required): https://openrouter.ai/keys
OPENROUTER_API_KEY=xxxxxxxxxxxx

# Primary model used for photo auto-fill (free multimodal model on OpenRouter)
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Comma-separated list of fallback models
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash-vl

# Frontend origin allowed to call this server (CORS)
FRONTEND_URL=http://localhost:5173
